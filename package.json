{
  "name": "universal-local-tools",
  "version": "2.0.0",
  "description": "Universal MCP server giving local models (LM Studio, Ollama, etc.) frontier-like capabilities: file ops, shell, web, code exec, git, DOCX generation",
  "main": "src/mcp-server-improved.mjs",
  "type": "module",
  "scripts": {
    "mcp:server": "node src/mcp-server-improved.mjs",
    "mcp:debug": "node scripts/debug-list-tools.mjs",
    "template:create": "node src/create-template.js",
    "generate:docx": "node src/generate-from-template.js",
    "test": "npm run template:create && npm run generate:docx"
  },
  "keywords": [
    "lm-studio",
    "mcp",
    "local-models",
    "automation",
    "sandbox",
    "tools"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.3",
    "pizzip": "^3.2.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.24.1"
  }
}